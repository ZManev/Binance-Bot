# Copy to .env.arbitrum-readonly on the VPS; chmod 600 the local file.
# Use an HTTPS Arbitrum One RPC URL from a provider account you control.
# Never commit the real file or paste credential-bearing URLs into chat/logs.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Required for Aave V3 market resolution. Obtain from the official Aave Address Book.
AAVE_V3_ADDRESSES_PROVIDER=

# Informational risk-budget target only; no funds are transferred or used.
CAPITAL_CAP_USDC=50
TARGET_NETWORK=arbitrum-one
TARGET_CHAIN_ID=42161

# Hard safety locks — do not change in this deployment profile.
EXECUTION_MODE=MAINNET_READ_ONLY
LIVE_TRADING=false
SIGNING_ENABLED=false
ALLOW_TRANSACTION_SUBMISSION=false
ALLOW_CONTRACT_DEPLOYMENT=false
EXECUTION_READY=false
