# Template only. Never commit real values. The deployment workflow injects these
# from GitHub Environment "production" secrets/variables into the VM container.
EXCHANGE_ID=binance
LIVE_TRADING=false
PORT=8080
POLL_INTERVAL_SECONDS=1
SPOOL_DIR=/var/lib/trading/spool
STATE_DB=/var/lib/trading/idempotency.sqlite3
KILL_SWITCH_FILE=/var/lib/trading/KILL

# Inject through GitHub Environment secrets; do not place values in this file:
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
# APPROVAL_SIGNING_SECRET=
# EXCHANGE_PASSWORD=
