FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
       "fastapi>=0.115,<1" \
       "uvicorn[standard]>=0.30,<1" \
       "httpx>=0.27,<1" \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid 10001 --no-create-home app

COPY --chown=10001:10001 arbitrage/ /app/arbitrage/
COPY --chown=10001:10001 dashboard/ /app/dashboard/

USER 10001:10001

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/api/health', timeout=3).read()"]

CMD ["uvicorn", "arbitrage.api.app:app", "--host", "0.0.0.0", "--port", "8787", "--no-access-log"]
